{
	"info": {
		"_postman_id": "8488e0b6-192a-4df4-8d4b-ffbfcb7b9ad1",
		"name": "Go REST Microservice API",
		"description": "Production validation test matrix for the 7-Day Go + MySQL Microservice API gateway.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Products Management",
			"item": [
				{
					"name": "Create Product (Valid Payload)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response contains assigned Auto-Increment ID\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.be.a('number');",
									"    pm.collectionVariables.set(\"last_created_id\", jsonData.id);",
									"});",
									"",
									"pm.test(\"Headers contain X-Request-ID tracing trace\", function () {",
									"    pm.response.headers.to.have.header(\"X-Request-ID\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-Request-ID",
								"value": "pm-test-trace-{{$guid}}",
								"description": "Day 7 Middleware Correlation String Tracing Tracker",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Premium Mechanical Ergonomic Keyboard\",\n    \"price\": 189.95\n}"
						},
						"url": {
							"raw": "{{base_url}}/products",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"products"
							]
						}
					},
					"response": []
				},
				{
					"name": "Create Product (Invalid Validation Payload)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 422 Unprocessable Entity\", function () {",
									"    pm.response.to.have.status(422);",
									"});",
									"",
									"pm.test(\"Response returns localized structural validation error tracking\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.error).to.include(\"Validation failed\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"\",\n    \"price\": -50.00\n}"
						},
						"url": {
							"raw": "{{base_url}}/products",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"products"
							]
						}
					},
					"response": []
				},
				{
					"name": "Fetch Product by Dynamic ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Data parameters structurally verified\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.name).to.be.a('string');",
									"    pm.expect(jsonData.price).to.be.a('number');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/products/{{last_created_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"products",
								"{{last_created_id}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Fetch Product (Missing Row ID Mapping)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 404 Not Found\", function () {",
									"    pm.response.to.have.status(404);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/products/99999",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"products",
								"99999"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "last_created_id",
			"value": "1",
			"type": "string"
		}
	]
}